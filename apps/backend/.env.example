# Configuração do backend. Em desenvolvimento copia para apps/backend/.env; no
# container LXC o instalador gera /etc/myhomelab/myhomelab.env com estes campos.

NODE_ENV=development
# Em produção o backend só ouve o nginx: HOST=127.0.0.1
HOST=0.0.0.0
PORT=3100

DATABASE_URL="postgresql://myhomelab:password@localhost:5432/myhomelab"

# Assina a sessão e o "state" do OAuth. Qualquer texto longo e aleatório:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# ⚠ NÃO ALTERAR depois de ligar contas: cifra os tokens do Google e a password do
# Nextcloud guardados na base de dados. Mudá-la torna-os ilegíveis e obriga a
# religar todas as contas. Base64 de 32 bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Endereço por onde se abre a app. Origem do CORS, destino do regresso do OAuth e
# decide o cookie seguro (https → secure).
FRONTEND_URL=http://localhost:5180

# Google (Gmail e Tasks). O redirect URI tem de estar registado na consola do Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3100/connected-account/google/callback

# Os servidores Proxmox do agente de servidor configuram-se na app (Definições →
# Servidores). Se PROXMOX_HOST, PROXMOX_TOKEN_NAME e PROXMOX_TOKEN_VALUE (e
# PROXMOX_USER) existirem, são importados uma vez para o primeiro admin, enquanto
# não houver nenhum servidor na base de dados.

# O Claude Code (a IA dos agentes): o executável, se não for o "claude" do PATH.
# CLAUDE_BIN=/usr/local/bin/claude
